# Ejemplo de configuración del servidor (correos y pagos). El archivo real (correo.env) vive SOLO en el servidor,
# en /opt/cafelaescuelita-correo/correo.env: activar-correo.sh lo crea y pide la contraseña.
# Nunca escribas la contraseña aquí ni la subas a git.
SMTP_HOST=smtp.hostinger.com
SMTP_PUERTO=465
SMTP_USUARIO=proyectos@digitalbrain.click
SMTP_CLAVE=
CORREO_DESTINO=cafelaescuelita@gmail.com
ORIGENES_PERMITIDOS=https://cafelaescuelita.site,https://www.cafelaescuelita.site
# Pagos con Bold (Panel de comercios > Integraciones). Sin llaves, los pagos en línea quedan apagados.
BOLD_LLAVE_IDENTIDAD=
BOLD_LLAVE_SECRETA=
# 1 = llaves de prueba de Bold
BOLD_PRUEBAS=0
